# values below are default included with the image but if you override the
# common config, dacha won't expose on the right ports so they are included
server.gracePeriodInSeconds=1
jersey.logging.exclude-entirely-uris=/health/liveness,/health/readiness,/metrics
server.port=8902
monitor.port=8279
dacha2.cache.api-key=example-api-key
# talk to the public port
management-repository.url=http://mr-server:8085
# redis fallback: when MR is unavailable, cache misses are served from redis. The redis settings are in a file
# that is re-read while dacha2 runs, so it can be switched on and off without a restart.
dacha2.redis.config-file=/etc/redis-config/redis.properties
dacha2.redis.config-reload-seconds=5
# probe MR quickly so recovery is seen fast in tests
dacha2.redis.mr-retry-interval-ms=2000
